# Copy to .env to override defaults. Every value already has a working default -
# the app runs with no .env at all. Nothing here is a secret or an API key.

# COMPASS_DATABASE_URL=sqlite:///./compass.db
# COMPASS_AUTO_SEED=true
# COMPASS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- ML tuning knobs ---
# COMPASS_ROUTE_CONFIDENCE_THRESHOLD=0.06
# COMPASS_WEIGHT_RELEVANCE=0.80
# COMPASS_WEIGHT_FEASIBILITY=0.20
# COMPASS_WEIGHT_FACULTY=0.00
# COMPASS_MMR_LAMBDA=0.70
# COMPASS_TOP_K=5
